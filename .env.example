# Copy to `.env` in the project root (or set these as environment variables in
# cPanel > Setup Python App). Never commit the real `.env`.

# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me

# Must be False in production.
DEBUG=False

# Comma-separated domains the site answers on.
ALLOWED_HOSTS=bapagelabs.com,www.bapagelabs.com
CSRF_TRUSTED_ORIGINS=https://bapagelabs.com,https://www.bapagelabs.com

# Database: "sqlite" (default) or "mysql".
DB_ENGINE=mysql
DB_NAME=cpaneluser_bpl
DB_USER=cpaneluser_bpl
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# Uploaded images. SERVE_MEDIA=True lets Django serve MEDIA_ROOT itself, which
# is the simplest option on shared hosting.
# MEDIA_ROOT=/home/cpaneluser/bpl/media
SERVE_MEDIA=True

# Collected static files (served by WhiteNoise).
# STATIC_ROOT=/home/cpaneluser/bpl/staticfiles

# HTTPS. If you get a redirect loop after enabling SSL, set
# SECURE_PROXY_SSL_HEADER=True (or SECURE_SSL_REDIRECT=False and redirect in .htaccess).
SECURE_SSL_REDIRECT=True
SECURE_PROXY_SSL_HEADER=False
SECURE_HSTS_SECONDS=3600

TIME_ZONE=Africa/Nairobi
